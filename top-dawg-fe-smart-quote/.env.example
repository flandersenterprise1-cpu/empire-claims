# ---------------------------------------------------------------------------
# Top Dawg FE Smart Quote — environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the app, migrations and seeds.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/topdawg

# Separate database used by `npm run test:integration`. Its contents are wiped
# on every run, so never point this at a database that holds real data.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/topdawg_test

# Secret used to sign admin session cookies (JWT, HS256).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Lifetime of an admin session, in hours.
AUTH_SESSION_HOURS=12

# Bootstrap administrator created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@topdawg.local
SEED_ADMIN_PASSWORD=ChangeMe!2024

# Number of days an anonymous quote session (and its health answers) is kept
# before it is treated as expired. Keep this short — quote data is disposable.
QUOTE_RETENTION_DAYS=30

# Set to "true" to load the clearly-labelled FICTIONAL demo carrier
# ("Sample Mutual (FICTIONAL)") so the engine can be exercised end to end.
# Its rates are invented. The server REFUSES TO START in production if this is
# "true", and the quote flow never shows it even when it is present.
SEED_DEMO_CARRIER=true

# Public base URL (used for absolute links). Optional in development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Production
# ---------------------------------------------------------------------------
# These are checked when the server boots. In production any problem aborts
# startup rather than serving an unprotected admin area; in development the
# same check only warns. GET /api/health reports the same findings by NAME,
# never by value.
#
#   DATABASE_URL        must not be localhost, and needs ?sslmode=require
#                       unless the database is on a private network. Health
#                       answers travel over this connection.
#   AUTH_SECRET         at least 32 characters, and not the value above.
#   SEED_ADMIN_PASSWORD not the example value above.
#   SEED_DEMO_CARRIER   must not be "true".
#
# Docker Compose also needs these:
# POSTGRES_USER=topdawg
# POSTGRES_PASSWORD=
# POSTGRES_DB=topdawg
# PORT=3000
